# Flask Configuration
SECRET_KEY=refind-ai-super-secret-key-change-in-production-2026
FLASK_ENV=development
FLASK_DEBUG=1

# Database Configuration (MySQL)
# Default MySQL connection details
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=rootpassword
MYSQL_DATABASE=refind_db

# Full Database URL (Optional: Overrides individual MySQL fields if provided)
# MySQL format: mysql+pymysql://root:password@localhost:3306/refind_db
# SQLite fallback format: sqlite:///refind.db
DATABASE_URL=mysql+pymysql://root:rootpassword@localhost:3306/refind_db

# Matching Engine Configuration
MATCH_THRESHOLD=60.0
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=app/static/uploads
